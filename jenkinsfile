//This is the jenkins file for my project. It is used to build, test, and deploy the project using Jenkins. The pipeline is defined using the declarative syntax and includes stages for building, testing, and deploying the project. The pipeline also includes post actions to clean up the workspace and handle success or failure scenarios.
@Library('shared') _
pipeline {
    agent { label 'worker-node'}
    environment {
        DOCKER_REPOUSER=credentials('docker-user')
        DOCKER_IMAGE=credentials('docker-image')
        IMAGE_TAG=credentials('image-tag')
    }
    stages {
        stage('BUILD: Install Dependencies') {
            steps {
                installDependencies()
            }
        }
        stage('TEST: Linting') {
            steps {
                echo 'Running linter...'
                sh 'npm run lint'
            }
        }
        stage('TEST: Supply chain Audit') {
            steps {
                sh 'npm audit --audit-level=high'
            }
        }
        stage('TEST: Automated Unit Tests') {
            steps {
                echo 'Running unit test suite...'
                sh 'npm test'
            }
        }
        stage('DOCKER: Build & Package Artifact') {
            steps {
                dockerPackage($DOCKER_REPOUSER, $DOCKER_IMAGE, $IMAGE_TAG)
            }
        }
        stage('DOCKER: Push to Registry') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh 'echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin'
                    sh 'docker push $DOCKER_USER/$DOCKER_IMAGE:$IMAGE_TAG'
                    sh 'docker push $DOCKER_USER/$DOCKER_IMAGE:$IMAGE_TAG'
                }
            }
        }
    }
    post {
        always {
            sh 'docker rmi $DOCKER_REPOUSER/$DOCKER_IMAGE:$IMAGE_TAG || true'
            sh 'docker rmi $DOCKER_REPOUSER/$DOCKER_IMAGE:$IMAGE_TAG || true'
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Review logs for compilation or test issues.'
        }
    }
}
